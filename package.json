{
    "author": "Peter Pfeufer",
    "name": "@ppfeufer/masonry",
    "version": "1.1.0",
    "description": "Cascading grid layout library",
    "main": "dist/masonry.js",
    "license": "GPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "https://github.com/ppfeufer/masonry"
    },
    "keywords": [
        "grid",
        "layout",
        "masonry",
        "cascading"
    ],
    "bugs": {
        "url": "https://github.com/ppfeufer/masonry/issues"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.4.1",
        "ev-emitter": "^2.1.2",
        "get-size": "^3.0.0",
        "globals": "^17.6.0",
        "jquery": "^4.0.0",
        "jquery-bridget": "^3.0.1",
        "outlayer": "^2.1.1",
        "terser": "^5.48.0"
    },
    "scripts": {
        "build:dist": "node src/scripts/build-dist.js",
        "build:dev": "node src/scripts/build-dev.js",
        "build": "npm run build:dist && npm run minify",
        "lint": "eslint --config eslint.config.js --ext .js --ignore-pattern '**/*.min.js' --ignore-pattern 'dist/**' --debug",
        "minify": "terser dist/masonry.js -o dist/masonry.min.js --source-map \"base='dist/',url='masonry.min.js.map'\" --compress reduce_vars=false --mangle --format quote_style=1"
    }
}
